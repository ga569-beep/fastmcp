+import pytest
+
+from fastmcp import FastMCP
+from fastmcp.server.middleware.tool_injection import (
+    PromptToolMiddleware,
+    ResourceToolMiddleware,
+    ToolInjectionMiddleware,
+)
+from fastmcp.tools.tool import Tool
+
+
+def _tool(name, value):
+    async def fn():
+        return value
+
+    return Tool.from_function(fn=fn, name=name)
+
+
+@pytest.mark.asyncio
+async def test_unique_injected_tool_appears_in_list_tools():
+    mcp = FastMCP("shadow-p2p")
+
+    injected = _tool("helper_status", "ok")
+    mcp.add_middleware(ToolInjectionMiddleware([injected]))
+
+    tools = await mcp.list_tools()
+
+    assert "helper_status" in {tool.name for tool in tools}
+
+
+@pytest.mark.asyncio
+async def test_unique_injected_tool_can_be_called():
+    mcp = FastMCP("shadow-p2p")
+
+    injected = _tool("helper_status", "ok")
+    mcp.add_middleware(ToolInjectionMiddleware([injected]))
+
+    result = await mcp.call_tool("helper_status", {})
+
+    assert result.content[0].text == "ok"
+
+
+@pytest.mark.asyncio
+async def test_normal_local_tool_still_works_without_injection_middleware():
+    mcp = FastMCP("shadow-p2p")
+
+    @mcp.tool(name="local_status")
+    async def local_status():
+        return "local-ok"
+
+    result = await mcp.call_tool("local_status", {})
+
+    assert result.content[0].text == "local-ok"
+
+
+@pytest.mark.asyncio
+async def test_multiple_unique_injected_tools_work():
+    mcp = FastMCP("shadow-p2p")
+
+    mcp.add_middleware(
+        ToolInjectionMiddleware(
+            [
+                _tool("helper_one", "one"),
+                _tool("helper_two", "two"),
+            ]
+        )
+    )
+
+    one = await mcp.call_tool("helper_one", {})
+    two = await mcp.call_tool("helper_two", {})
+
+    assert one.content[0].text == "one"
+    assert two.content[0].text == "two"
+
+
+@pytest.mark.asyncio
+async def test_prompt_tool_middleware_exposes_helpers_without_collision():
+    mcp = FastMCP("shadow-p2p")
+    mcp.add_middleware(PromptToolMiddleware())
+
+    tools = await mcp.list_tools()
+
+    names = {tool.name for tool in tools}
+    assert "list_prompts" in names
+    assert "get_prompt" in names
+
+
+@pytest.mark.asyncio
+async def test_resource_tool_middleware_exposes_helpers_without_collision():
+    mcp = FastMCP("shadow-p2p")
+    mcp.add_middleware(ResourceToolMiddleware())
+
+    tools = await mcp.list_tools()
+
+    names = {tool.name for tool in tools}
+    assert "list_resources" in names
+    assert "read_resource" in names
